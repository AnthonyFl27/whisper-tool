#!/usr/bin/env bash
# whisper-tool: graba el audio que suena en el equipo, muestra un espectrograma en vivo
# y lo transcribe con faster-whisper. Iniciar con Enter/Espacio; detener con Ctrl+C.
# Uso: ./whisper-tool [modelo]   (sin modelo, muestra un menú para elegirlo)
# La primera vez crea el entorno virtual e instala las dependencias.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

VENV=.venv-whisper

if ! command -v pw-record >/dev/null; then
    echo "Error: falta 'pw-record' (PipeWire). Esta herramienta solo funciona en Linux con PipeWire." >&2
    exit 1
fi

# Crea el venv si no existe e instala las dependencias si falta alguna
# (también repara una instalación que se cortó a medias).
if [ ! -x "$VENV/bin/python" ]; then
    command -v python3 >/dev/null || { echo "Error: falta python3." >&2; exit 1; }
    echo "Primera ejecución: creando entorno virtual..."
    python3 -m venv "$VENV" || { echo "Error: no se pudo crear el venv (en Debian/Ubuntu: sudo apt install python3-venv)." >&2; rm -rf "$VENV"; exit 1; }
fi
if ! "$VENV/bin/python" -c "import faster_whisper, numpy, rich" 2>/dev/null; then
    echo "Instalando dependencias (solo la primera vez)..."
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install -r requirements.txt
fi

exec "$VENV/bin/python" src/grabar.py "$@"
